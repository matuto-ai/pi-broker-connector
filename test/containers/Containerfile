# Same exact Node 24.19 baseline already verified by upstream broker container CI.
FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df
RUN npm install --prefix /opt/pi-host --ignore-scripts --no-audit --no-fund @earendil-works/pi-coding-agent@1.4.0
WORKDIR /connector
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --legacy-peer-deps --no-audit --no-fund
# Build with the single artifact produced and validated by npm test -- --output .artifacts.
COPY .artifacts/*.tgz /tmp/pi-package/
RUN set -- /tmp/pi-package/*.tgz; test "$#" -eq 1 \
    && tar -xzf "$1" --strip-components=1 -C /connector \
    && rm -rf /tmp/pi-package
USER node
